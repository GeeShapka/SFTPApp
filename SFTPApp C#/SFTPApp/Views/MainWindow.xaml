<Window x:Class="SFTPApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SFTPApp.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="540" Width="960"
        xmlns:vms="clr-namespace:SFTPApp.ViewModels"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <ComboBox ItemsSource="{Binding UserPresetNames}"
                      SelectedItem="{Binding CurrentPresetName}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <StackPanel>
                    <Label Content="Preset Name"/>
                    <TextBox Text="{Binding PresetName}"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Username"/>
                    <TextBox Text="{Binding Username}"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Password"/>
                    <TextBox Text="{Binding Password}"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Host Ip Address"/>
                    <TextBox Text="{Binding IpAddress}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Save Current Preset" Margin="0, 0, 5, 0" Command="{Binding SaveCurrentPresetCommand}"/>
                <Button Content="Save New Preset" Command="{Binding SaveNewPresetCommand}"/>
            </StackPanel>


            <Button Name="btnLocalFile"
                    Click="btnLocalFile_Click"
                    Content="Local File/Folder"
                    Margin="50"
                    Grid.Column="0"/>
        </StackPanel>


        <Button Grid.Column="1" Margin="50" Content="Connect" Command="{Binding ConnectToRemoteComputerCommand}"/>



        <!--remote machine section-->
        <StackPanel Grid.Column="2">
            <StackPanel Orientation="Horizontal">
                <Button Content="Root Directory"
                    Width="100"
                    Click="btnRemoteRootDirectory_Click"/>
                <ComboBox ItemsSource="{Binding RemotePathPresets}"/>
            </StackPanel>
            <DataGrid IsReadOnly="True" 
                      ItemsSource="{Binding RemoteFileOptions}"
                      Height="400">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
