<Window x:Class="SFTPApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SFTPApp.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        xmlns:vms="clr-namespace:SFTPApp.ViewModels"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Button Name="btnLocalFile"
                Click="btnLocalFile_Click"
                Content="Local File/Folder"
                Margin="50"
                Grid.Column="0"/>
        <Button Grid.Column="1" Margin="50" Content="Connect" Command="{Binding ConnectToRemoteComputerCommand}"/>
        <!--<ListView Grid.Column="2" ItemsSource="{Binding FileOptions}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Dir" DisplayMemberBinding="{Binding IsDirectory}"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                </GridView>
            </ListView.View>
        </ListView>-->
        <DataGrid Grid.Column="2" IsReadOnly="True" ItemsSource="{Binding FileOptions}"/>
    </Grid>
</Window>
